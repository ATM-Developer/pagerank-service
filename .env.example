# Copy to .env and fill in. .env is gitignored - never commit real keys here.
# One or more URLs per chain, comma-separated (no spaces needed either way);
# added to the RPC pool alongside the public ones in project/settings.cfg.
# Chain names match the CHAINS keys there.
# PRIVATE_RPC_BINANCE=https://your-provider/bsc-testnet/<key>
# PRIVATE_RPC_BINANCE=https://your-provider/bsc-testnet/<key1>,https://your-provider2/bsc-testnet/<key2>
# PRIVATE_RPC_MATIC=https://your-provider/polygon-testnet/<key>
# PRIVATE_RPC_AVAX=https://your-provider/avax-fuji/<key>
# PRIVATE_RPC_ETH=https://your-provider/eth/<key>
# PRIVATE_RPC_BITKUB=https://your-provider/bitkub-testnet/<key>
